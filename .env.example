# BBank — environment template. Copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored; this file is tracked and must never contain a real secret.

# ---- Database ------------------------------------------------------------
# Required. There is no fallback: the API refuses to start without it (WI-07).
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=bbank

# Composed from the three values above. Inside compose the host is `db`;
# for a local `go run` against the mapped port use localhost:5433.
DATABASE_URL=postgres://admin:change-me-before-first-run@db:5432/bbank?sslmode=disable

# ---- API -----------------------------------------------------------------
PORT=8000
LOG_LEVEL=info

# Comma-separated exact origins allowed to call the API from a browser (WI-03).
# Empty means no cross-origin browser access, which is correct for the
# server-to-server topology the frontend actually uses.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Frontend ------------------------------------------------------------
# Server components and server actions reach the API over the compose network.
API_BASE_URL=http://goapp:8000

# ---- Auth (WI-17) ----
# ES256 (P-256) signing key. The API signs with it; the frontend only ever
# receives the PUBLIC half from GET /api/v1/auth/public-key.
# Generate: openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt
# The process refuses to start without this, unless ALLOW_EPHEMERAL_JWT_KEY=true.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...replace me...\n-----END PRIVATE KEY-----\n"
JWT_ISSUER=https://api.bbank.local
JWT_AUDIENCE=bbank-web
# Set false only for local http development. Read by BOTH the API (which sets the
# cookies) and the frontend (which re-sets them onto its own origin) — they must
# agree, or the browser silently discards every session cookie.
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Deprecated API surface (WI-21, TRD §6.1)
# ---------------------------------------------------------------------------
# Serves the old /api/go/* paths by rewriting them to /api/v1/*. This is only
# the STARTING value: the flag is changed at runtime through
# PATCH /api/v1/admin/flags (admin only), because the point of the shim is to be
# switched off experimentally and switched back on fast if something breaks.
# Sunset: Wed, 31 Mar 2027.
LEGACY_API_SHIM=true
